<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>

<ListView fx:id="layersList" editable="true" minHeight="60.0" prefWidth="250.0" stylesheets="@../css/layers.css"
          xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.mobipic.controller.LayersController">
   <placeholder>
      <Label text="%layers.empty" />
   </placeholder>
   <contextMenu>
      <ContextMenu>
        <items>
            <MenuItem fx:id="rename" mnemonicParsing="false" text="%action.rename" />
            <MenuItem fx:id="toggleVisibility" mnemonicParsing="false" text="%action.toggleVisibility" />
            <SeparatorMenuItem />
            <MenuItem fx:id="duplicate" mnemonicParsing="false" text="%action.duplicate" />
            <MenuItem fx:id="delete" mnemonicParsing="false" text="%action.delete" />
            <SeparatorMenuItem />
            <MenuItem fx:id="rotateLeft" mnemonicParsing="false" text="%action.rotateLeft" />
            <MenuItem fx:id="rotateRight" mnemonicParsing="false" text="%action.rotateRight" />
            <MenuItem fx:id="filters" mnemonicParsing="false" text="%action.filter" />
        </items>
      </ContextMenu>
   </contextMenu>
</ListView>
