<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.Pane?>

<!-- The Group makes the ScrollPane account for the zoom, which scales the surface (canvas + text editor). -->
<Group xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mobipic.controller.CanvasController">
   <children>
      <Pane fx:id="surface">
         <children>
            <Canvas fx:id="canvas" styleClass="drawing-canvas" onMouseDragged="#onDragged" onMouseMoved="#onMoved" onMousePressed="#onPressed"
                    onMouseReleased="#onReleased" onMouseExited="#onExited" />
         </children>
      </Pane>
   </children>
</Group>
